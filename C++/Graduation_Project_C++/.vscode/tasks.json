{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Bank Project",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "-Iinclude",
                "src/main.cc",
                "src/Bank.cc",
                "src/Account.cc",
                "src/SavingsAccount.cc",
                "src/CheckingAccount.cc",
                "-o",
                "bank"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
