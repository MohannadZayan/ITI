{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Bank",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "${workspaceFolder}/src/*.cc",
                "-I${workspaceFolder}/include",
                "-o",
                "${workspaceFolder}/bank"
            ],
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}